{
  "expo": {
    "name": "Paris Hindu Summit Mail",
    "slug": "paris-hindu-summit-mail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/summit-logo.png",
    "scheme": "parishindusummitmail",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.parishindusummit.mail",
      "supportsTablet": true
    },
    "android": {
      "package": "org.parishindusummit.mail",
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/images/summit-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/images/summit-logo.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
